# Copy this file to `.env` and fill in real values for the services you want
# enabled. Anything left blank uses safe defaults — the pipeline will run in
# mock mode and produce non-trivial results without external API calls.

# ── Required for production ──
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-32

# ── Optional ──
DATABASE_URL=sqlite:///./smartgrade.db
UPLOAD_DIR=./uploads

# ── External services (leave blank to run in mock mode) ──
# Path to a Google Cloud service-account JSON file with Vision API access.
GOOGLE_APPLICATION_CREDENTIALS=

# Anthropic API key for LLM-as-judge grading on written answers.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
